# AI Agent Remote bridge for the Herdr you use on this computer, discoverable on your Wi-Fi.
#
# You don't need to copy this: `agent-remote service install` (or, in a checkout,
# `bun src/cli.ts service install` in server/) writes ~/.config/systemd/user/agent-remote.service
# with the right paths and your PATH, enables and starts it. This file shows what it writes for a
# checkout; to use it by hand:
#
#   cp deploy/systemd/agent-remote.service ~/.config/systemd/user/
#   # edit WorkingDirectory/ExecStart if this checkout or bun live elsewhere
#   systemctl --user daemon-reload && systemctl --user enable --now agent-remote
#
# A user service starts at login; `loginctl enable-linger` makes it start at boot. The first start
# creates ~/.local/share/herdr-remote (TLS for <hostname>.local and your LAN addresses). Phones on
# the same network see this computer under "On this network" and pair with the 6-digit code that
# pops up here. Stop it with: systemctl --user stop agent-remote
[Unit]
Description=AI Agent Remote bridge
After=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/agent-remote-server/server
ExecStart=%h/.bun/bin/bun src/cli.ts up
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
