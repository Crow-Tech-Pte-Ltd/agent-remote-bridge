<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ~/Library/LaunchAgents/sg.crowtech.agent-remote.plist; `agent-remote service install --state DIR` writes one like this for you. -->
<plist version="1.0"><dict>
  <key>Label</key><string>sg.crowtech.agent-remote</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PATH/agent-remote</string><string>serve</string>
    <string>--state</string><string>/ABSOLUTE/PATH/private-host-state</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/private-host-state/service.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/private-host-state/service-error.log</string>
</dict></plist>
